# ===== 复制为 .env 后按实际填写（切勿提交到 git）=====

# --- Python 量化引擎 ---
QUANT_ENGINE_URL=http://localhost:8000

# --- 回测默认参数 ---
QUANT_DEFAULT_START=2021-01-01
QUANT_COST_BPS=10
QUANT_CACHE_TTL=600

# --- 鉴权（复用博客 JWT，HS256，密钥需 >=32 字节）---
QUANT_AUTH_ENABLED=false
JWT_SECRET=

# --- Redis（复用博客底座）---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- MySQL（后续接自选股 / 回测记录时启用）---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=quant
MYSQL_USER=quant
MYSQL_PASSWORD=
